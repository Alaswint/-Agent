# 依赖
node_modules/

# 构建产物
.next/
out/
build/
dist/

# 环境变量（含密钥）
.env
.env.local
.env.*.local

# 运行时数据（对话历史、模型配置、API Key、提醒、记忆、审计日志、用量统计、MCP 配置 —— 均含用户隐私）
data/*
!data/.gitkeep

# 角色数据（含对话历史与角色设定）
characters/*
!characters/.gitkeep

# 插件（用户自定义 HTTP 工具，可能含私有端点）
plugins/*
!plugins/.gitkeep

# 截图输出（可能含桌面隐私）
public/screenshots/*
!public/screenshots/.gitkeep

# 上传头像
public/avatars/*
!public/avatars/.gitkeep

# 工作区私有配置
.workbuddy/

# 日志
*.log
npm-debug.log*

# 系统文件
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
